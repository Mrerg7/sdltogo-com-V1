---
import '../styles/global.css';
import { SITE, OG_IMAGE, PUBLISHED_DATE, DOMAIN_PRICE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = OG_IMAGE,
  noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(pathname, SITE.url);
const modifiedDate = '2026-09-07';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}#website`,
      url: SITE.url,
      name: SITE.name,
      description,
      inLanguage: 'en-US',
      publisher: { '@id': `${SITE.url}#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${SITE.url}#webpage`,
      url: SITE.url,
      name: title,
      description,
      isPartOf: { '@id': `${SITE.url}#website` },
      mainEntity: { '@id': `${SITE.url}#product` },
      datePublished: PUBLISHED_DATE,
      dateModified: modifiedDate,
      inLanguage: 'en-US',
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.url}#organization`,
      name: 'SDL Domains',
      url: SITE.url,
      email: SITE.email,
      logo: OG_IMAGE,
      contactPoint: {
        '@type': 'ContactPoint',
        email: SITE.email,
        contactType: 'sales',
        url: SITE.url,
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Scottsdale',
        addressRegion: 'AZ',
        addressCountry: 'US',
      },
    },
    {
      '@type': 'Product',
      '@id': `${SITE.url}#product`,
      name: 'sdltogo.com Premium Domain Name',
      description:
        'The definitive premium domain for custom delivery, catering, party setup, and event staffing in Scottsdale, Arizona. Available for acquisition.',
      url: SITE.url,
      image: OG_IMAGE,
      category: 'Premium Domain Name',
      brand: {
        '@type': 'Brand',
        name: 'sdltogo.com',
      },
      offers: {
        '@type': 'Offer',
        '@id': `${SITE.url}#offer`,
        url: SITE.url,
        price: DOMAIN_PRICE.price,
        priceCurrency: DOMAIN_PRICE.currency,
        priceValidUntil: DOMAIN_PRICE.priceValidUntil,
        priceSpecification: {
          '@type': 'PriceSpecification',
          price: DOMAIN_PRICE.price,
          minPrice: DOMAIN_PRICE.minPrice,
          maxPrice: DOMAIN_PRICE.maxPrice,
          priceCurrency: DOMAIN_PRICE.currency,
        },
        availability: 'https://schema.org/InStock',
        itemCondition: 'https://schema.org/NewCondition',
        seller: { '@id': `${SITE.url}#organization` },
        shippingDetails: {
          '@type': 'OfferShippingDetails',
          shippingRate: {
            '@type': 'MonetaryAmount',
            value: '0',
            currency: 'USD',
          },
          deliveryTime: {
            '@type': 'ShippingDeliveryTime',
            handlingTime: {
              '@type': 'QuantitativeValue',
              minValue: 1,
              maxValue: 3,
              unitCode: 'DAY',
            },
            transitTime: {
              '@type': 'QuantitativeValue',
              minValue: 0,
              maxValue: 0,
              unitCode: 'DAY',
            },
          },
          shippingDestination: {
            '@type': 'DefinedRegion',
            addressCountry: 'US',
          },
        },
        hasMerchantReturnPolicy: {
          '@type': 'MerchantReturnPolicy',
          applicableCountry: 'US',
          returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
          merchantReturnDays: 0,
          returnMethod: 'https://schema.org/ReturnByMail',
          returnFees: 'https://schema.org/ReturnFeesCustomerResponsibility',
        },
      },
      review: [
        {
          '@type': 'Review',
          author: { '@type': 'Organization', name: 'SDL Domains' },
          datePublished: PUBLISHED_DATE,
          reviewBody:
            'A short, brandable .com domain ideally suited for Scottsdale catering, custom delivery, party setup, and premium event staffing brands.',
          reviewRating: {
            '@type': 'Rating',
            ratingValue: 5,
            bestRating: 5,
          },
        },
      ],
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: 5,
        bestRating: 5,
        reviewCount: 1,
        ratingCount: 1,
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="sdltogo.com, Scottsdale catering domain for sale, event staffing domain Scottsdale, party setup service domain Arizona, premium delivery service domain"
    />
    <meta name="author" content="SDL Domains" />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="sdltogo.com — Premium Domain for Scottsdale Catering & Event Services"
    />
    <meta property="og:locale" content={SITE.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="sdltogo.com — Premium Domain for Scottsdale Catering & Event Services"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {SITE.googleSiteVerification && (
      <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
  </body>
</html>
