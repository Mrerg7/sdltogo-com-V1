---
import { ACQUISITION_MAILTO, cfImageUrl, CF_IMAGES } from '../config/site';

const heroImage = cfImageUrl(CF_IMAGES.heroImageId);
---

<header class="relative min-h-[min(720px,92svh)] flex items-center overflow-hidden bg-slate-900">
  <img
    src={heroImage}
    alt="Scottsdale luxury catering, delivery, and premium event staffing"
    class="absolute inset-0 h-full w-full object-cover object-center md:object-[72%_center]"
    fetchpriority="high"
    decoding="async"
    width="1920"
    height="1080"
  />

  <!-- Readable text zone on the left; image stays visible on the right -->
  <div
    class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/55 to-slate-950/10 md:to-transparent"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 bg-gradient-to-t from-slate-950/50 via-transparent to-slate-950/15"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 w-full max-w-5xl mx-auto px-4 sm:px-6 py-24 md:py-16">
    <div class="max-w-2xl md:max-w-3xl">
      <div
        class="inline-flex items-center gap-x-2 bg-white/10 backdrop-blur-md border border-white/20 px-3 sm:px-4 py-1.5 rounded-3xl mb-6 sm:mb-8"
      >
        <div class="w-1.5 h-1.5 shrink-0 bg-emerald-400 rounded-full animate-pulse"></div>
        <span class="text-xs sm:text-sm font-semibold tracking-[1px] sm:tracking-[1.5px] text-white/90">
          PREMIUM SERVICE DOMAIN &bull; SCOTTSDALE, AZ
        </span>
      </div>

      <h1 class="text-white">
        <span class="block font-bold tracking-tighter domain-name">sdltogo.com</span>
      </h1>

      <p class="mt-4 max-w-xl text-lg sm:text-2xl text-white/90 tracking-tight leading-snug">
        The premium domain for custom delivery, catering, and premium event staffing in Scottsdale,
        Arizona.
      </p>

      <div class="mt-8 sm:mt-9 flex flex-col sm:flex-row gap-3 sm:gap-4">
        <a
          href={ACQUISITION_MAILTO}
          class="inline-flex items-center justify-center min-h-[48px] px-8 sm:px-10 py-3.5 sm:py-4 bg-white text-slate-900 hover:bg-amber-50 font-semibold rounded-3xl text-base transition-all active:scale-[0.985] shadow-xl"
        >
          Inquire to Purchase
        </a>
        <a
          href="#market"
          class="inline-flex items-center justify-center min-h-[48px] px-8 py-3.5 sm:py-4 border border-white/30 hover:bg-white/10 text-white font-semibold rounded-3xl text-base transition-all text-center"
        >
          Explore Scottsdale Market
        </a>
      </div>

      <div
        class="mt-6 sm:mt-8 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-x-6 text-sm text-white/60"
      >
        <div>Short &bull; Memorable &bull; Service-Focused</div>
        <div class="hidden sm:block w-px h-3 bg-white/30"></div>
        <div>Delivery &bull; Catering &bull; Event Staffing</div>
      </div>
    </div>
  </div>
</header>

<div class="border-b border-slate-200 bg-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4 sm:py-5">
    <div
      class="flex flex-col sm:flex-row sm:flex-wrap justify-center md:justify-between items-center gap-3 sm:gap-x-8 text-sm text-center md:text-left"
    >
      <div>Scottsdale: Premier market for luxury private events, catering &amp; premium service</div>
      <div class="hidden md:block text-slate-300">•</div>
      <div>High demand for reliable, high-end event staffing and setup</div>
    </div>
  </div>
</div>
