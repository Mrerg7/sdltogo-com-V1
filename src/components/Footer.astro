---
import { ACQUISITION_MAILTO, DISCLAIMER_DATE, SITE } from '../config/site';
---

<footer class="bg-slate-950 border-t border-white/10">
  <div class="max-w-5xl mx-auto px-6 py-16">
    <!-- Sophisticated Domain Acquisition CTA -->
    <div
      class="relative overflow-hidden rounded-3xl border border-amber-700/25 bg-gradient-to-br from-slate-900 via-slate-950 to-amber-900/10 p-8 sm:p-12 mb-12"
    >
      <div
        class="absolute -top-24 -right-24 w-64 h-64 rounded-full bg-amber-700/10 blur-3xl pointer-events-none"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute -bottom-24 -left-24 w-64 h-64 rounded-full bg-amber-600/10 blur-3xl pointer-events-none"
        aria-hidden="true"
      >
      </div>

      <div class="relative z-10 grid lg:grid-cols-[1.2fr_0.8fr] gap-10 items-center">
        <div>
          <p class="text-xs uppercase tracking-[3px] text-amber-500 font-extrabold mb-4">
            Domain Available for Acquisition
          </p>
          <h2 class="font-display text-3xl sm:text-4xl tracking-tight text-white mb-4">
            sdltogo.com — A Category-Defining Digital Asset
          </h2>
          <p class="text-slate-400 max-w-xl leading-relaxed">
            Positioned at the intersection of Scottsdale event services, premium catering branding, and
            luxury hospitality, this domain is a rare strategic asset. Serious buyers may inquire for
            pricing, transfer logistics, and escrow options.
          </p>
        </div>

        <div
          class="rounded-2xl p-6 sm:p-8 border border-white/10 bg-slate-900/90 backdrop-blur-xl"
        >
          <p class="text-xs uppercase tracking-[2px] text-slate-500 font-semibold mb-2">
            Acquisition Contact
          </p>
          <a
            href={`mailto:${SITE.email}`}
            class="block text-2xl sm:text-3xl font-display text-white hover:text-amber-400 transition-colors break-all"
          >
            {SITE.email}
          </a>
          <a
            href={ACQUISITION_MAILTO}
            class="mt-6 inline-flex w-full items-center justify-center gap-x-3 px-6 py-4 bg-gradient-to-r from-amber-700 to-amber-800 text-white font-extrabold rounded-2xl hover:brightness-110 transition-all"
          >
            <span>Inquire About Acquisition</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <p class="mt-4 text-[11px] text-slate-500 text-center tracking-wide">
            Confidential inquiries &bull; Response within 24 hours
          </p>
        </div>
      </div>
    </div>

    <!-- Disclaimer -->
    <p class="text-xs text-slate-500 leading-relaxed max-w-4xl mb-10">
      This website is for demonstration and informational purposes only. It does not constitute an offer of
      services, a commitment to deploy, or a guarantee of outcomes. All statistics, projections, and
      references to specific technologies are based on publicly available information as of {DISCLAIMER_DATE}
      and are subject to change.
    </p>

    <!-- Bottom bar -->
    <div
      class="pt-8 border-t border-white/10 text-xs text-slate-500 flex flex-col md:flex-row gap-y-4 items-center justify-between"
    >
      <div>&copy; 2026 SDL Domains. All rights reserved. Scottsdale, Arizona.</div>
      <div class="flex items-center gap-x-5">
        <span>Premium service domains &bull; Serious buyers only</span>
      </div>
    </div>
  </div>
</footer>
