---
import { ACQUISITION_MAILTO, SITE } from '../config/site';
---

<section id="acquire" class="bg-slate-900 py-16">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <div class="inline px-4 py-1 rounded-3xl bg-white/10 text-white text-xs tracking-[1.5px] font-medium mb-4">
      SERIOUS INQUIRIES ONLY
    </div>
    <h2 class="text-white text-4xl md:text-5xl tracking-tighter font-semibold">
      Ready to own sdltogo.com?
    </h2>
    <p class="mt-4 text-white/70 max-w-md mx-auto">
      Premium service-oriented domains that perfectly describe delivery, catering, and event staffing in
      high-demand luxury markets are rare. Contact us for confidential discussion.
    </p>

    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={ACQUISITION_MAILTO}
        class="inline-flex items-center justify-center gap-x-3 px-10 py-4 bg-white text-slate-900 hover:bg-amber-50 font-semibold rounded-3xl text-base transition-all active:scale-[0.985] shadow-xl"
      >
        <span>Inquire About Acquisition</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </a>

      <button
        id="copy-email-btn"
        type="button"
        class="inline-flex items-center justify-center gap-x-3 px-8 py-4 border border-white/30 hover:bg-white/10 text-white font-semibold rounded-3xl text-base transition-all"
      >
        <span id="copy-btn-text">Copy Contact Email</span>
      </button>
    </div>

    <p class="mt-8 text-sm text-white/50">
      We typically respond within 24–48 hours. All inquiries are confidential.
    </p>
  </div>
</section>

<section class="max-w-5xl mx-auto px-6 py-16 text-center">
  <div class="max-w-lg mx-auto">
    <p class="text-sm text-slate-500">Part of the SDL family of premium Scottsdale &amp; Phoenix-focused domains</p>
    <div class="mt-4 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm">
      <a href="https://sdl.contact" target="_blank" rel="noopener noreferrer" class="font-medium text-amber-brand hover:text-amber-800">sdl.contact → Scottsdale Directory</a>
      <span class="text-slate-300 hidden md:inline">•</span>
      <a href="https://sdl.hair" target="_blank" rel="noopener noreferrer" class="font-medium text-amber-brand hover:text-amber-800">sdl.hair → Premium Hair Domain</a>
      <span class="text-slate-300 hidden md:inline">•</span>
      <a href="https://phx.beauty" target="_blank" rel="noopener noreferrer" class="font-medium text-amber-brand hover:text-amber-800">phx.beauty → Phoenix Beauty</a>
      <span class="text-slate-300 hidden md:inline">•</span>
      <a href="https://sdldwntwn.com" target="_blank" rel="noopener noreferrer" class="font-medium text-amber-brand hover:text-amber-800">sdldwntwn.com → Downtown Scottsdale</a>
      <span class="text-slate-300 hidden md:inline">•</span>
      <a href="https://sdl.life" target="_blank" rel="noopener noreferrer" class="font-medium text-amber-brand hover:text-amber-800">sdl.life → Scottsdale Luxury Living</a>
      <span class="text-slate-300 hidden md:inline">•</span>
      <a href="https://sdlrealtor.com" target="_blank" rel="noopener noreferrer" class="font-medium text-amber-brand hover:text-amber-800">sdlrealtor.com → Scottsdale Realtor</a>
      <span class="text-slate-300 hidden md:inline">•</span>
      <a href="https://sdl.rentals" target="_blank" rel="noopener noreferrer" class="font-medium text-amber-brand hover:text-amber-800">sdl.rentals → Scottsdale Rentals</a>
      <span class="text-slate-300 hidden md:inline">•</span>
      <a href="https://sdlreo.com" target="_blank" rel="noopener noreferrer" class="font-medium text-amber-brand hover:text-amber-800">sdlreo.com → Scottsdale REO</a>
      <span class="text-slate-300 hidden md:inline">•</span>
      <a href="https://sdl.space" target="_blank" rel="noopener noreferrer" class="font-medium text-amber-brand hover:text-amber-800">sdl.space → Scottsdale Storage &amp; Events</a>
      <span class="text-slate-300 hidden md:inline">•</span>
      <a href="https://sdl.today" target="_blank" rel="noopener noreferrer" class="font-medium text-amber-brand hover:text-amber-800">sdl.today → Scottsdale News &amp; Commentary</a>
    </div>
  </div>
</section>

<script>
  function copyEmail() {
    const email = 'sales@desertrich.com';
    navigator.clipboard.writeText(email).then(() => {
      const btn = document.getElementById('copy-btn-text');
      if (btn) {
        const original = btn.textContent;
        btn.textContent = 'Copied to clipboard!';
        setTimeout(() => {
          btn.textContent = original;
        }, 2200);
      }
    }).catch(() => {
      window.location.href = 'mailto:sales@desertrich.com';
    });
  }
  document.getElementById('copy-email-btn')?.addEventListener('click', copyEmail);
</script>
