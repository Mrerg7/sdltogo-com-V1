---
import { getCollection } from 'astro:content';

const marketStats = (await getCollection('marketStats')).sort((a, b) => a.data.order - b.data.order);
---

<section class="max-w-5xl mx-auto px-6 py-16" id="market">
  <div class="max-w-2xl mb-10">
    <div class="uppercase tracking-[2px] text-xs font-semibold text-amber-brand mb-3">THE MARKET</div>
    <h2 class="text-4xl tracking-tighter font-semibold">
      Scottsdale offers exceptional demand for premium catering, event staffing, and party services.
    </h2>
    <p class="mt-4 text-sm text-slate-600">
      With world-class resorts, golf communities, luxury private homes, a vibrant tourism industry, and an
      active social calendar, Scottsdale consistently generates high demand for reliable, high-quality
      catering, event staffing, setup, and cleanup services.
    </p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
    {
      marketStats.map((stat) => (
        <div class="bg-white border border-slate-200 rounded-3xl p-7">
          <div class="text-amber-brand text-xs tracking-widest font-semibold mb-2">{stat.data.label}</div>
          <div class="font-semibold text-lg">{stat.data.title}</div>
          <p class="mt-3 text-sm text-slate-600">{stat.data.description}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-8 text-xs text-slate-500 max-w-3xl">
    Market insights based on Scottsdale's strong tourism, luxury residential base, resort industry, and active
    private/corporate event calendar. Demand for premium catering and event staffing remains consistently
    high.
  </div>
</section>
